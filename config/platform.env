# Project R8Q UEFI Platform Configuration Environment
# Target: Samsung Galaxy S20 FE 5G (SM-G781B / r8q / SM8250)
#
# This file contains a mix of source-verified constants and explicit
# candidates. Read docs/RESEARCH_BASELINE.md and docs/VERIFICATION_LEDGER.md
# before using any value. A value here is not automatically a hardware fact.

export TARGET_DEVICE="Samsung Galaxy S20 FE 5G"
export TARGET_MODEL="SM-G781B"
export TARGET_CODENAME="r8q"
export TARGET_SOC="Qualcomm SM8250 (Snapdragon 865)"
# Commonly reported SM8250 SoC ID; verify at runtime.
export TARGET_SOC_ID="356"
export TARGET_ARCH="AARCH64"

# ---------------------------------------------------------------------------
# Pinned upstream dependencies
# ---------------------------------------------------------------------------
export EDK2_REPO="https://github.com/tianocore/edk2.git"
export EDK2_TAG="edk2-stable202411"
export EDK2_COMMIT="0f3867fa6ef0553e26c42f7d71ff6bdb98429742"
export EDK2_FALLBACK_TAG="edk2-stable202408.01"
export EDK2_FALLBACK_COMMIT="4dfdca63a93497203f197ec98ba20e2327e4afe4"
# Candidate EDK II toolchain tag; not build-validated yet.
export EDK2_TOOLCHAIN_TAG="GCC5"
export GCC_VERSION_MIN="14.0.0"

# ---------------------------------------------------------------------------
# Memory: captured-unit evidence, not a universal constant
# ---------------------------------------------------------------------------
# The captured downstream FDT describes two RAM ranges:
#   0x80000000 + 0x3BB00000
#   0xC0000000 + 0x1C0000000
# Total is approximately 7.93 GiB. Other units may be 6 GB or differ.
export MEMORY_BASE_PHYS="0x80000000"
export MEMORY_SIZE_PHYS="runtime"
export MEMORY_TOTAL_GB="runtime"

# ---------------------------------------------------------------------------
# Display: reserved continuous-splash framebuffer (source-verified)
# ---------------------------------------------------------------------------
# The buffer is described by upstream Linux and the downstream FDT.
# Whether ABL leaves scanout active at handoff is UNKNOWN.
export FB_BASE_PHYS="0x9C000000"
export FB_SIZE_PHYS="0x02300000" # 35 MiB
export DISPLAY_WIDTH=1080
export DISPLAY_HEIGHT=2400
export DISPLAY_BPP=32
export DISPLAY_STRIDE=4320
export DISPLAY_FORMAT="a8r8g8b8"

# ---------------------------------------------------------------------------
# Interrupts and timer (source-verified)
# ---------------------------------------------------------------------------
export GICD_BASE_PHYS="0x17A00000"
export GICR_BASE_PHYS="0x17A60000"
export ARCH_TIMER_FREQ_HZ=19200000 # 19.2 MHz

# ---------------------------------------------------------------------------
# Storage and peripherals (source-verified addresses)
# ---------------------------------------------------------------------------
export UFS_HC_BASE_PHYS="0x01D84000"
export UFS_ICE_BASE_PHYS="0x01D90000"
export SDHCI_BASE_PHYS="0x08804000"
export USB_DWC3_BASE_PHYS="0x0A600000"
export UART_BASE_PHYS="0x00988000" # SoC UART; physical access unverified

# ---------------------------------------------------------------------------
# Firmware placement: candidates, not validated load addresses
# ---------------------------------------------------------------------------
# Candidate A: 12 MiB gap after dfps_data and before sec_debug.
export FD_BASE_CANDIDATE="0x9E400000"
export FD_SIZE_CANDIDATE="0x00400000"
# Candidate B: edk2-msm reference window; reference only.
export FD_BASE_REFERENCE_EDK2_MSM="0xCE000000"
export FD_SIZE_REFERENCE_EDK2_MSM="0x00700000"

# ---------------------------------------------------------------------------
# Safety and evidence
# ---------------------------------------------------------------------------
export ALLOW_DEVICE_WRITES=0
export DEVICE_TREE_EVIDENCE="devicetree/r8q-live.dts"
export DEVICE_TREE_SANITIZED=1
export MANIFEST_SCHEMA_VERSION=2
export QEMU_BIN="qemu-system-aarch64"
