# Project R8Q Linux Kernel Configuration: Native Linux Operating System Baseline
# Target: Samsung Galaxy S20 FE 5G (SM-G781B / r8q)
# SoC: Qualcomm Snapdragon 865 (SM8250 / Kona)
# Architecture: ARM64 / AArch64 (ARMv8.2-A)
# License: GPL-2.0

# Core Architecture & Qualcomm SoC
CONFIG_ARCH_QCOM=y
CONFIG_ARM64=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
CONFIG_NR_CPUS=8
CONFIG_COMPAT=y

# Power State Coordination & CPU Management
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y

# Interconnect & Clocks (Qualcomm SM8250)
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_SM8250_GCC=y
CONFIG_QCOM_SM8250_DISPCC=y
CONFIG_QCOM_SM8250_GPUCC=y
CONFIG_QCOM_SM8250_CAMCC=y

# UEFI & EFI Stub Support (Standards-Compliant Boot)
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_GENERIC_STUB=y
CONFIG_EFI_VARS=y
CONFIG_EFI_RUNTIME_WRAPPERS=y
CONFIG_RESET_ATTACK_MITIGATION=y
CONFIG_ACPI=y
CONFIG_ACPI_GENERIC_GSI=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_SPCR_TABLE=y

# Device Tree (FDT) Subsystem
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_RESERVED_MEM=y

# Framebuffer & Display Engine
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y

# Adreno 650 GPU (Freedreno DRM Subsystem)
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_GPU_STATE=y

# Qualcomm GENI & QEMU PL011 Serial Console
CONFIG_SERIAL_MSM_GENI=y
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_SERIAL_MSM_GENI_EARLY_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# Storage Subsystems (UFS 3.1 & MicroSD SDHCI & VirtIO)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_MODERN_MSI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# PCIe Bus Subsystem
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y

# Wireless Networking (Qualcomm QCA6390 Wi-Fi 6 on PCIe RC0 [17cb:1101])
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m

# Cellular Modem Subsystem (Snapdragon X55 5G on PCIe RC2 [17cb:0306])
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_BAM_DMUX=m

# USB Subsystem (DWC3 Controller & Type-C)
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_STORAGE=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y

# Input & Touchscreen (FocalTech FTS / sec_touchscreen)
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_QPNP_POWER_ON=y

# Audio Architecture (Qualcomm LPASS & WCD9385 Codec)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_SM8250=m
CONFIG_SND_SOC_WCD938X=m
CONFIG_SND_SOC_WCD938X_SDW=m

# Power Management, PMIC & Fuel Gauge (Maxim MAX77705 & PM8150)
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_AOSS=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SPMI_PMIC=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_POWER_SUPPLY=y
CONFIG_REGMAP=y
CONFIG_REGMAP_I2C=y
CONFIG_REGMAP_IRQ=y
CONFIG_MFD_MAX77705=y
CONFIG_BATTERY_MAX77705=m
CONFIG_CHARGER_MAX77705=m

# Thermal Management
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# Initramfs, Core Filesystems & Userspace Plumbing
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_BTRFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Modern Linux Systemd / OpenRC Foundation
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_AUTOFS4_FS=y

# Kernel Diagnostics & Logging
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
