## @file
#  R8QPkg.fdf
#  Project R8Q Firmware Flash Definition File
#  Target: Samsung Galaxy S20 FE 5G (SM-G781B / r8q)
#
#  Copyright (c) 2026, Antigravity Engineering. All rights reserved.
##

[FD.R8Q_EFI]
BaseAddress   = 0x9E400000|gArmTokenSpaceGuid.PcdFdBaseAddress
Size          = 0x00400000|gArmTokenSpaceGuid.PcdFdSize
ErasePolarity = 1
BlockSize     = 0x00001000
NumBlocks     = 0x400

0x00000000|0x00400000
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVMAIN_COMPACT

[FV.FVMAIN_COMPACT]
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

APRIORI PEI {
}

INF R8QPkg/PrePi/PrePi.inf
INF R8QPkg/Drivers/SimpleFbDxe/SimpleFbDxe.inf
INF R8QPkg/Drivers/FileVariableDxe/FileVariableDxe.inf
INF R8QPkg/Drivers/StorageProtectionDxe/StorageProtectionDxe.inf
INF MdeModulePkg/Universal/HiiDatabaseDxe/HiiDatabaseDxe.inf
INF MdeModulePkg/Universal/Disk/UnicodeCollation/EnglishDxe/EnglishDxe.inf
INF MdeModulePkg/Universal/Disk/DiskIoDxe/DiskIoDxe.inf
INF MdeModulePkg/Universal/Disk/PartitionDxe/PartitionDxe.inf
INF FatPkg/EnhancedFatDxe/Fat.inf
INF MdeModulePkg/Bus/Usb/UsbMassStorageDxe/UsbMassStorageDxe.inf
INF ShellPkg/Application/Shell/Shell.inf
INF R8QPkg/Applications/CoreTest/CoreTest.inf
INF R8QPkg/Applications/StorageTest/StorageTest.inf
INF R8QPkg/Applications/SysInfo/SysInfo.inf
INF R8QPkg/Applications/CpuInfo/CpuInfo.inf
INF R8QPkg/Applications/MemMap/MemMap.inf
INF R8QPkg/Applications/Display/Display.inf
INF R8QPkg/Applications/FdtInfo/FdtInfo.inf
INF R8QPkg/Applications/Storage/Storage.inf
INF R8QPkg/Applications/Battery/Battery.inf
INF R8QPkg/Applications/Thermal/Thermal.inf
INF R8QPkg/Applications/Firmware/Firmware.inf
INF R8QPkg/Applications/Diagnostics/Diagnostics.inf
INF R8QPkg/Applications/ShellTest/ShellTest.inf
INF R8QPkg/Applications/LinuxBoot/LinuxBoot.inf
INF R8QPkg/Applications/Setup/Setup.inf
INF R8QPkg/Applications/BootManager/BootManager.inf

[Rule.Common.SEC]
  FILE SEC = $(NAMED_GUID) RELOCS_STRIPPED {
    TE  TE    Align = 4K   $(INF_OUTPUT)/$(MODULE_NAME).efi
  }

[Rule.Common.DXE_DRIVER]
  FILE DRIVER = $(NAMED_GUID) {
    DXE_DEPEX DXE_DEPEX Optional      $(INF_OUTPUT)/$(MODULE_NAME).depex
    PE32      PE32                    $(INF_OUTPUT)/$(MODULE_NAME).efi
    UI        STRING="$(MODULE_NAME)" Optional
  }

[Rule.Common.UEFI_DRIVER]
  FILE DRIVER = $(NAMED_GUID) {
    DXE_DEPEX DXE_DEPEX Optional      $(INF_OUTPUT)/$(MODULE_NAME).depex
    PE32      PE32                    $(INF_OUTPUT)/$(MODULE_NAME).efi
    UI        STRING="$(MODULE_NAME)" Optional
  }

[Rule.Common.DXE_RUNTIME_DRIVER]
  FILE DRIVER = $(NAMED_GUID) {
    DXE_DEPEX DXE_DEPEX Optional      $(INF_OUTPUT)/$(MODULE_NAME).depex
    PE32      PE32                    $(INF_OUTPUT)/$(MODULE_NAME).efi
    UI        STRING="$(MODULE_NAME)" Optional
  }

[Rule.Common.UEFI_APPLICATION]
  FILE APPLICATION = $(NAMED_GUID) {
    PE32      PE32                    $(INF_OUTPUT)/$(MODULE_NAME).efi
    UI        STRING="$(MODULE_NAME)" Optional
  }
