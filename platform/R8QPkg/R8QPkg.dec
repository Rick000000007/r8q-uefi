##

[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = R8QPkg
  PACKAGE_GUID                   = 3e4b7b20-1a74-4b5c-8902-8a9d1871e84a
  PACKAGE_VERSION                = 1.1.0

[Includes]
  Include

[Guids]
  gR8QPkgTokenSpaceGuid          = { 0x4f5c8c31, 0x2b85, 0x4c6d, { 0x9a, 0x13, 0x9b, 0xae, 0x29, 0x82, 0x47, 0x5b } }
  gR8QAuthorizedTestMediaGuid    = { 0x7c49e921, 0x2945, 0x4d53, { 0x8a, 0xb2, 0x8b, 0xa3, 0x25, 0x93, 0x62, 0x51 } }

[Protocols]
  gR8QBatteryProtocolGuid        = { 0xa482e811, 0x1812, 0x4f1b, { 0x89, 0xc1, 0x90, 0x42, 0x77, 0x70, 0x51, 0x01 } }
  gR8QThermalProtocolGuid        = { 0xb593f922, 0x2923, 0x4e2c, { 0x9a, 0xd2, 0x01, 0x53, 0x88, 0x81, 0x62, 0x02 } }
  gR8QStorageProtectionProtocolGuid = { 0x6e28f810, 0x1834, 0x4f32, { 0x9b, 0xa1, 0x7a, 0x92, 0x14, 0x82, 0x51, 0x40 } }

[PcdsFixedAtBuild]
  # Display: continuous-splash framebuffer described by upstream Linux and the
  # downstream FDT. Scanout state at ABL handoff is UNKNOWN.
  gR8QPkgTokenSpaceGuid.PcdFrameBufferBase|0x9C000000|UINT64|0x00000001
  gR8QPkgTokenSpaceGuid.PcdFrameBufferSize|0x02300000|UINT32|0x00000002
  gR8QPkgTokenSpaceGuid.PcdDisplayWidth|1080|UINT32|0x00000003
  gR8QPkgTokenSpaceGuid.PcdDisplayHeight|2400|UINT32|0x00000004
  gR8QPkgTokenSpaceGuid.PcdDisplayBpp|32|UINT32|0x00000005
  gR8QPkgTokenSpaceGuid.PcdDisplayStride|4320|UINT32|0x00000006

  # Serial debug UART: Hardware verified on SM-G781B as QUP SE12 at 0x00A90000.
  gR8QPkgTokenSpaceGuid.PcdUartBaseAddress|0x00A90000|UINT64|0x00000010
  gR8QPkgTokenSpaceGuid.PcdUartBaudRate|115200|UINT32|0x00000011

  # Interrupt controller and architectural timer: source-verified.
  gR8QPkgTokenSpaceGuid.PcdGicDistributorBase|0x17A00000|UINT64|0x00000012
  gR8QPkgTokenSpaceGuid.PcdGicRedistributorsBase|0x17A60000|UINT64|0x00000013
  gR8QPkgTokenSpaceGuid.PcdArchTimerFreqInHz|19200000|UINT32|0x00000014

  # Storage and USB controller addresses: source-verified. LUN layout, card
  # detect, and USB host mode remain runtime/board unknowns.
  gR8QPkgTokenSpaceGuid.PcdUfsHostControllerBase|0x01D84000|UINT64|0x00000020
  gR8QPkgTokenSpaceGuid.PcdSdhciControllerBase|0x08804000|UINT64|0x00000021
  gR8QPkgTokenSpaceGuid.PcdUfsIceBase|0x01D90000|UINT64|0x00000022
  gR8QPkgTokenSpaceGuid.PcdUsbDwc3Base|0x0A600000|UINT64|0x00000023
