[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = PrePi
  FILE_GUID                      = 8f2b7405-2b4a-4d7a-8b31-89e4726c9b31
  MODULE_TYPE                    = SEC
