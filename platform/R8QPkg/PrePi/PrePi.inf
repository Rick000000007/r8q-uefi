  EmbeddedPkg/EmbeddedPkg.dec
  R8QPkg/R8QPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  IoLib
  ArmLib
  FdtLib

[FixedPcd]
  gR8QPkgTokenSpaceGuid.PcdFrameBufferBase
  gR8QPkgTokenSpaceGuid.PcdDisplayWidth
  gR8QPkgTokenSpaceGuid.PcdDisplayHeight
